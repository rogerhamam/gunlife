# Intermediate build output. bin/kaj_shooter.exe is tracked on purpose -- see
# below -- so this only drops the object files and the CMake cache.
/build/
*.obj
*.o

# Screenshot test output -- regenerated by tools/smoketest.ps1
/testshots/

# Python
__pycache__/
*.pyc

# The raw GMK 8.0 dump (tools/gmk_extract.py) and the original audio download.
# These are the *sources* the staging tools read; everything the game actually
# loads has been staged into assets/ and is tracked, so a clone is playable
# without them.
/extracted/
/drive-download-*/
*.gmk

# Editor / OS noise
.vscode/
.idea/
Thumbs.db
desktop.ini
