# Intermediate build output. bin/kaj_shooter.exe is tracked on purpose -- see
# below -- so this only drops the object files and the CMake cache.
#
# Note the compiler-object rules are scoped to /build/. A bare `*.obj` also
# matches Wavefront meshes, and assets/models holds four of them -- the tank's
# hull and turret and the gunship's airframe and rotor, cut out of the .glb by
# the split tools. Ignoring those leaves a clone with a turret that will not
# traverse and a rotor that will not turn.
/build/
/build/**/*.obj
/build/**/*.o
*.o

# Screenshot test output -- regenerated by tools/smoketest.ps1
/testshots/

# Python
__pycache__/
*.pyc

# The raw GMK 8.0 dump (tools/gmk_extract.py) and the original audio download.
# These are the *sources* the staging tools read; everything the game actually
# loads has been staged into assets/ and is tracked, so a clone is playable
# without them.
/extracted/
/drive-download-*/
*.gmk

# Editor / OS noise
.vscode/
.idea/
Thumbs.db
desktop.ini
